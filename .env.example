# Copie para .env.local e preencha os valores.
# Onde encontrar: Supabase Dashboard → Project Settings → API

# URL do projeto (seguro no client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anon/publishable (seguro no client — RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role (SEGREDO — só em Server Actions; usada para convidar usuários)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Senha do banco Postgres (Project Settings → Database). Só para `npm run db:sql`; a aplicação não usa.
SUPABASE_PASSWORD=

# Importação assistida por IA (/admin/importar). Basta UMA das chaves; sem nenhuma a página mostra aviso.
# Gemini (grátis no Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic (pago; melhor leitura de fotos/PDF difíceis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: força o provedor (anthropic | gemini). Padrão: Anthropic se tiver chave, senão Gemini.
AI_PROVIDER=
